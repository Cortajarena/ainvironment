# cp .env.example .env   — fill in, never commit .env (see .gitignore)

# ---- container user (match your host user: id -u / id -g) ----
DEV_UID=1000
DEV_GID=1000

# ---- bind mounts ----
WORKSPACES_DIR=/nvme0n1-disk/workspaces
# host docker CLI + compose plugin mounted into the container (DooD,
# version-matched to the host daemon)
DOCKER_BIN=/usr/bin/docker
DOCKER_PLUGINS=/usr/libexec/docker/cli-plugins
# host docker group id -> socket access for the container user
# (getent group docker | cut -d: -f3)
DOCKER_GID=987

# ---- host loopback ports (cloudflared maps subdomains onto these) ----
PORT_CODE_SERVER=8080
PORT_OPENCODE=4096
PORT_OPENCHAMBER=3000

# ---- secrets ----
# code-server: HASHED (argon2) preferred, PASSWORD as plain fallback
CODE_SERVER_PASSWORD=
CODE_SERVER_HASHED_PASSWORD=
# openchamber web UI password (empty = no UI password)
OPENCHAMBER_UI_PASSWORD=
