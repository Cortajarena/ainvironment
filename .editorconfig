# Keep the repo tidy: max line length 90 everywhere.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 90

[*.{md,yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab

[scripts/nanocode.sh]
# verbatim copy of the old installer, kept as porting reference
max_line_length = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
